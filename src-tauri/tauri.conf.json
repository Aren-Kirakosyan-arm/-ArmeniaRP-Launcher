{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArmeniaRP Launcher",
  "version": "0.1.0",
  "identifier": "am.armeniarp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArmeniaRP Launcher",
        "width": 1160,
        "height": 760,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
