<Application x:Class="ArmeniaRP.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#090D14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111824" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#172131" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A0B5" />
        <SolidColorBrush x:Key="GoldBrush" Color="#D7A84A" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2E73FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#31C48D" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF5B6E" />
    </Application.Resources>
</Application>
